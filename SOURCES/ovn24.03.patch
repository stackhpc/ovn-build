-    stats->idle_age_ms = ofp_stats->idle_age * 1000;
-    stats->data.fdb = (struct mac_cache_fdb_data) {
-            .port_key = ofp_stats->match.flow.regs[MFF_LOG_INPORT - MFF_REG0],
