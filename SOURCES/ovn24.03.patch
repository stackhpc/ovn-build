+                      ETH_ADDR_SCAN_ARGS(ps_addr->phys_addr))) {
+        VLOG_WARN_RL(&rl, "invalid syntax '%s' in port security for LSP %s: "
+                     "No MAC address found", entry, lsp);
+        return false;
+    }
+
+    bool ok = true;
