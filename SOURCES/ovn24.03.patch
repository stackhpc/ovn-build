+        struct masked_eth_addr *maddr6 = xmalloc(sizeof *maddr6);
+        memcpy(maddr6, &maddr_any_vrrp6, sizeof *maddr6);
+        ovs_list_push_back(&ps_addr->vrrp6, &maddr6->node);
+    }
+
+    return ok;
+}
