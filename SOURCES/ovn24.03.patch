+check multinode_nbctl --wait=sb sync
+
+for i in 1 2 3; do
+    check_ping migrator ovn-chassis-1 sw0-port${i} "lost"
+    check_ping mig-cont ovn-chassis-1 cont${i} "lost"
+    check_ping migrator ovn-chassis-1 cont${i} "lost"
