+check ovn-nbctl ls-add ls0
+
+check ovn-nbctl lrp-add lr0 lrp0 00:00:00:00:00:01 10.0.0.1/24 fe80::1/64
+check ovn-nbctl lsp-add-router-port ls0 lsp0-router lrp0
