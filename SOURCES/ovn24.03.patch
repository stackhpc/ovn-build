+uuid_v4_2=$(fetch_column Mac_Binding _uuid ip=42.42.42.253)
+uuid_v6_1=$(fetch_column Mac_Binding _uuid ip=\"fd11::64\")
+uuid_v6_2=$(fetch_column Mac_Binding _uuid ip=\"fd12::64\")
