-        struct packet_data *p = CONTAINER_OF(ovs_list_pop_front(&bp->queue),
-                                             struct packet_data, node);
-
-        ovn_packet_data_destroy(p);
-    }
-    ovs_list_push_back(&bp->queue, &pd->node);
-}
